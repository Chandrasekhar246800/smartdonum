generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model donation {
  id        Int      @id @default(autoincrement())
  donorType String
  item      String
  status    String   @default("pending")
  details   Json?
  createdAt DateTime @default(now())
}
